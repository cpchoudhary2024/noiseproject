{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "UPLOAD_FOLDER": "/tmp/uploads",
    "ARTIFACTS_DIR": "/tmp/artifacts"
  }
}

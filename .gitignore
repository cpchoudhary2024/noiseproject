# ─── PII GUARD — participant identities (never publish) ───
# These scripts embed study-participant names and home street addresses in
# site-mapping dictionaries. They are deliberately kept local: useful for
# generating resident-facing deliverables, unsafe to publish.
# Verified untracked and absent from git history at the time this was added.
tools/build_word_reports.py
tools/build_brief.py
tools/build_control_comparison.py
tools/build_boxplot_assessment.py
tools/compute_exceedance.py
tools/data/exceedance_results.json

# Raw logger folders are named by participant (site code + given name).
data/raw/community-loggers/

# Resident-facing deliverables carry names/addresses on the page.
Resident*Report*.docx
*Home ?*.docx
